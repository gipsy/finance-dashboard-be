# Copy to `.env` for local development (see README).
#
# MONGO_URL must be a MongoDB Atlas connection string (hosted cluster), not a
# local `mongodb://127.0.0.1` URL. In Atlas: Database → Connect → Drivers,
# create a DB user, allow your IP (or 0.0.0.0/0 for dev only), then paste the
# SRV URI and set the database name (e.g. finance-dashboard).
#
# Example shape (replace user, password, cluster host, and db name):
# MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/finance-dashboard?retryWrites=true&w=majority

MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/finance-dashboard?retryWrites=true&w=majority
PORT=9000
